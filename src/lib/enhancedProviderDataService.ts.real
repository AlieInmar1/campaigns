/**
 * Validate that the filter has at least one primary filter selected
 */
export function validatePrimaryFilter(filter: EnhancedProviderFilter): boolean {
  return !!(
    (filter.specialties && filter.specialties.length > 0) ||
    filter.medicationCategory ||
    (filter.includedMedications && filter.includedMedications.length > 0)
  );
}

/**
 * Get estimated provider count based on filter criteria
 */
export async function estimateFilteredProviderCount(filter: EnhancedProviderFilter): Promise<number> {
  try {
    // Validate primary filter requirement
    if (!validatePrimaryFilter(filter)) {
      return 0;
    }
    
    console.log('Estimating count with filter:', JSON.stringify(filter, null, 2));
    
    // Call the RPC function
    const { data, error } = await supabase.rpc('estimate_filtered_provider_count', {
      specialties: filter.specialties || null,
      medication_category: filter.medicationCategory || null,
      included_medication_ids: filter.includedMedications || null,
      excluded_medication_ids: filter.excludedMedications || null,
      brand_preference: filter.brandPreference || 'both',
      regions: filter.regions || null,
      timeframe: filter.timeframe || 'year',
      gender: filter.gender || 'all'
    });
    
    if (error) {
      console.error('Error estimating provider count:', error);
      return 0;
    }
    
    console.log('Estimated count result:', data);
    return data || 0;
  } catch (error) {
    console.error('Error estimating provider count:', error);
    return 0;
  }
}

/**
 * Get providers filtered by the enhanced filter criteria
 */
export async function getProvidersByEnhancedFilter(
  filter: EnhancedProviderFilter
): Promise<FilteredProviderResponse[]> {
  try {
    // Validate primary filter requirement
    if (!validatePrimaryFilter(filter)) {
      throw new Error('At least one primary filter must be selected (specialty, category, or medications)');
    }
    
    console.log('Getting providers with filter:', JSON.stringify(filter, null, 2));
    
    const { data, error } = await supabase.rpc('get_filtered_providers', {
      specialties: filter.specialties || null,
      medication_category: filter.medicationCategory || null,
      included_medication_ids: filter.includedMedications || null,
      excluded_medication_ids: filter.excludedMedications || null,
      brand_preference: filter.brandPreference || 'both',
      regions: filter.regions || null,
      timeframe: filter.timeframe || 'year',
      gender: filter.gender || 'all'
    });
    
    if (error) {
      console.error('Error fetching filtered providers:', error);
      return [];
    }
    
    console.log(`Got ${data?.length || 0} filtered providers`);
    return data || [];
  } catch (error) {
    console.error('Error fetching filtered providers:', error);
    return [];
  }
}

/**
 * Get provider details by IDs
 */
export async function getProviderDetailsByIds(providerIds: string[]): Promise<any[]> {
  if (!providerIds.length) {
    return [];
  }
  
  try {
    console.log(`Getting details for ${providerIds.length} providers`);
    const CHUNK_SIZE = 1000; // Process in chunks to handle large datasets
    let allProviders: any[] = [];
    
    for (let i = 0; i < providerIds.length; i += CHUNK_SIZE) {
      const chunk = providerIds.slice(i, i + CHUNK_SIZE);
      
      // Try with provider_id first
      let { data, error } = await supabase
        .from('providers')
        .select('*')
        .in('provider_id', chunk)
        .order('npi');
      
      // If that fails, try with id
      if (error) {
        console.log('Error with provider_id, trying with id field instead');
        const response = await supabase
          .from('providers')
          .select('*')
          .in('id', chunk)
          .order('npi');
          
        data = response.data;
        error = response.error;
      }
        
      if (error) {
        console.error('Error fetching provider details:', error);
        continue;
      }
      
      if (data) {
        // Transform the data to ensure it has the expected fields
        const transformedData = data.map(provider => ({
          ...provider,
          // Ensure provider has a provider_id field (use id if provider_id is missing)
          provider_id: provider.provider_id || provider.id,
          // Ensure provider has a name field (use npi if name is missing)
          name: provider.name || `Provider ${provider.npi}`,
          // Ensure provider has a geographic_area field (use region if geographic_area is missing)
          geographic_area: provider.geographic_area || provider.region
        }));
        
        allProviders = [...allProviders, ...transformedData];
      }
    }
    
    console.log(`Retrieved ${allProviders.length} provider details`);
    return allProviders;
  } catch (error) {
    console.error('Error getting provider details:', error);
    return [];
  }
}

/**
 * Combine filtering and detail fetching in one operation
 */
export async function getFilteredProviderDetails(
  filter: EnhancedProviderFilter,
  limit: number = 500
): Promise<any[]> {
  try {
    // Get filtered provider IDs
    const filteredProviders = await getProvidersByEnhancedFilter(filter);
    
    if (!filteredProviders.length) {
      return [];
    }
    
    // Limit the number of providers to fetch details for
    const limitedProviderIds = filteredProviders
      .slice(0, limit)
      .map((p: FilteredProviderResponse) => p.provider_id);
    
    // Fetch provider details
    const providerDetails = await getProviderDetailsByIds(limitedProviderIds);
    
    // Add prescription count to provider details
    return providerDetails.map(provider => {
      const matchingProvider = filteredProviders.find((p: FilteredProviderResponse) => p.provider_id === provider.provider_id);
      return {
        ...provider,
        prescription_count: matchingProvider ? matchingProvider.prescription_count : 0
      };
    });
  } catch (error) {
    console.error('Error getting filtered provider details:', error);
    return [];
  }
}

/**
 * Get recommended specialties based on selected medications
 * This helps with smart suggestions when a medication is selected
 */
export async function getRecommendedSpecialties(medicationIds: string[]): Promise<string[]> {
  if (!medicationIds.length) {
    return [];
  }
  
  try {
    // Find specialties that commonly prescribe these medications
    const { data, error } = await supabase
      .from('medication_provider_time_index')
      .select('provider_id')
      .in('medication_id', medicationIds)
      .order('total_count', { ascending: false })
      .limit(100); // Get top prescribers
      
    if (error || !data.length) {
      return [];
    }
    
    // Get specialties for these providers
    const providerIds = data.map((p: any) => p.provider_id);
    
    const { data: providerSpecialties, error: specialtyError } = await supabase
      .from('providers')
      .select('specialty')
      .in('provider_id', providerIds);
      
    if (specialtyError) {
      return [];
    }
    
    // Count and sort specialties by frequency
    const specialtyCounts: Record<string, number> = {};
    providerSpecialties.forEach((p: any) => {
      if (!p.specialty) return;
      specialtyCounts[p.specialty] = (specialtyCounts[p.specialty] || 0) + 1;
    });
    
    // Sort specialties by frequency and return top 5
    return Object.entries(specialtyCounts)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 5)
      .map(([specialty]) => specialty);
  } catch (error) {
    console.error('Error getting recommended specialties:', error);
    return [];
  }
}
