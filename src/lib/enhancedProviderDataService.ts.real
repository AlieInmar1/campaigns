import { supabase } from './supabase';

/**
 * Enhanced Provider Filter interface
 * At least one primary filter is required
 */
export interface EnhancedProviderFilter {
  // Primary filters (at least one required)
  specialties?: string[];
  medicationCategory?: string;
  includedMedications?: string[];
  
  // Secondary filters
  excludedMedications?: string[];
  brandPreference?: 'brand' | 'generic' | 'both';
  regions?: string[];
  timeframe?: 'month' | 'quarter' | 'year';
  gender?: 'male' | 'female' | 'all';
}

/**
 * Response containing filtered providers with prescription counts
 */
export interface FilteredProviderResponse {
  provider_id: string;
  prescription_count: number;
}

/**
 * Get available medication categories
 */
export async function getMedicationCategories(): Promise<string[]> {
  try {
    console.log('Fetching medication categories from database...');
    
    // First, check if the medications table has a category column
    const { data: tableInfo, error: tableError } = await supabase
      .from('information_schema.columns')
      .select('column_name')
      .eq('table_name', 'medications')
      .eq('column_name', 'category');
      
    if (tableError) {
      console.error('Error checking medications table schema for category column:', tableError);
    } else {
      console.log('Category column exists:', tableInfo);
    }
    
    // Query the medications table for categories
    const { data, error } = await supabase
      .from('medications')
      .select('category')
      .not('category', 'is', null)
      .order('category');
      
    if (error) {
      console.error('Error fetching medication categories:', error);
      return [];
    }
    
    // Extract unique categories
    const categories = [...new Set(data.map((item: any) => item.category))] as string[];
    console.log(`Found ${categories.length} unique medication categories:`, categories);
    
    return categories;
  } catch (error) {
    console.error('Error fetching medication categories:', error);
    return [];
  }
}

/**
 * Get medications by category
 */
export async function getMedicationsByCategory(category?: string): Promise<any[]> {
  try {
    console.log('Fetching medications from database...');
    
    // First, check if the medications table exists and has the expected columns
    const { data: tableInfo, error: tableError } = await supabase
      .from('information_schema.columns')
      .select('column_name')
      .eq('table_name', 'medications');
      
    if (tableError) {
      console.error('Error checking medications table schema:', tableError);
    } else {
      console.log('Medications table columns:', tableInfo);
    }
    
    // Query the medications table
    let query = supabase
      .from('medications')
      .select('*')
      .order('medication_name');
      
    // Apply category filter if provided
    if (category) {
      query = query.eq('category', category);
    }
      
    const { data, error } = await query;
      
    if (error) {
      console.error('Error fetching medications:', error);
      return [];
    }
    
    console.log('Raw medication data:', data?.slice(0, 3)); // Log first few items for debugging
    
    // Transform the data to match what the component expects
    const transformedData = (data || []).map(med => ({
      id: med.id,
      name: med.medication_name || med.name, // Try both field names
      category: med.category,
      subcategory: med.subcategory || 'General', // Provide a default subcategory
      is_brand_name: med.is_brand_name || med.brand_generic === 'brand',
      is_target_medication: med.is_target_medication || false
    }));
    
    console.log(`Transformed ${transformedData.length} medications`);
    return transformedData;
  } catch (error) {
    console.error('Error fetching medications:', error);
    return [];
  }
}

